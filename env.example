# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MOONSHOT_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key

# GitHub Copilot (uses CLI authentication, no API key required)
# Install Copilot CLI: https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-cli
# Then authenticate: copilot auth login

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Financial Data Provider
# Choose one: financialdatasets (default) or alphavantage
FINANCIAL_DATA_PROVIDER=financialdatasets

# Financial Datasets API Key (if using financialdatasets provider)
# Get your API key at: https://www.financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-api-key

# Alpha Vantage API Key (if using alphavantage provider)
# Get your API key at: https://www.alphavantage.co/support/#api-key
# Note: Free tier has 25 requests/day limit
ALPHAVANTAGE_API_KEY=your-api-key

# Web Search API Keys (Exa → Perplexity → Tavily)
EXASEARCH_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=true

# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key

# GitHub Copilot (uses CLI authentication, no API key required)
# Install Copilot CLI: https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-cli
# Then authenticate: copilot auth login

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Stock Market API Key
FINANCIAL_DATASETS_API_KEY=your-api-key

# Web Search API Keys (Exa preferred, Tavily fallback)
EXASEARCH_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=true
